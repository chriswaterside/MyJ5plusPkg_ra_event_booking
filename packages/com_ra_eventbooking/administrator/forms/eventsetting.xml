<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_eventbooking\Administrator\Field">
  
    <fieldset name="basic" label="Basic Information">
        <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
        <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="ordering"/>
        <field name="checked_out" type="hidden" filter="unset"/>
        <field name="checked_out_time" type="hidden" filter="unset"/>
        <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_MODIFIED_BY"/>
        <field name="event_id" 
               filter="safehtml" 
               type="text" 
               required="true" 
               label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_EVENT_ID" 
               description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_EVENT_ID" 
               hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_EVENT_ID"
        />
  
        <field name="booking_data" 
               type="editor" 
               hidden="true" 
               buttons="true" class="inputbox" filter="safehtml" 
               label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_BOOKING_DATA" 
               description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_BOOKING_DATA" 
               hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_BOOKING_DATA"
        />
        <field name="waiting_data" 
               type="editor" 
               hidden="true" 
               buttons="true" class="inputbox" filter="safehtml" 
               label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_WAITING_DATA" 
               description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_WAITING_DATA" 
               hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_WAITING_DATA"
        />
        <field name="event_data" 
               type="editor" 
               hidden="true" 
               buttons="true" class="inputbox" filter="safehtml" 
               label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_EVENT_DATA" 
               description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_EVENT_DATA"  
               hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_EVENT_DATA"
        />
  
    </fieldset>
    <fields name="params">  <!-- This becomes JSON automatically -->
        <fieldset name="params" label="Options">
            <field name="total_places" 
                   first="0" last="200" step="1" type="integer" 
                   useglobal="true" 
                   label="Total number of Places" 
                   description="Total or maximum number of places or zero if unlimited places" 
            />   
            <field name="attendeetype" 
                   type="list" 
                   useglobal="true"
                   label="Who can attend?" 
                   description="Is event open to the public or just members" 
            >
                <option value="memonly">Members Only</option>
                <option value="public">Non members welcome</option>
            </field>
            
            
            
            // user access
            <field 
                name="maxattendees" 
                first="1" last="10" step="1" type="integer" 
                useglobal="true" 
                label="COM_RA_EVENTBOOKING_FORM_LBL_MAXATTENDEES" 
                description="COM_RA_EVENTBOOKING_FORM_DESC_MAXATTENDEES" 
                hint="COM_RA_EVENTBOOKING_FORM_LBL_MAXATTENDEES"
            />
            <field name="waitinglist" 
                   type="list" 
                   useglobal="true" 
                   default=""
                   label="COM_RA_EVENTBOOKING_FORM_LBL_WAITINGLIST" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_WAITINGLIST" 
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_WAITINGLIST"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>  
            <field name="userlistvisibletousers" 
                   type="list" 
                   useglobal="true" 
                   default=""
                   label="COM_RA_EVENTBOOKING_FORM_LBL_USERLISTVISIBLETOUSERS" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_USERLISTVISIBLETOUSERS" 
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_USERLISTVISIBLETOUSERS"
            >
               
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field> 
            
            // guest access
            
            <field name="guest" 
                   type="list" 
                   useglobal="true" 
                   default=""
                   validate="options"
                   label="COM_RA_EVENTBOOKING_FORM_LBL_GUEST" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_GUEST"
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_GUEST"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field name="telephone_required" 
                   type="list" 
                   validate="options"
                   useglobal="true" 
                   default=""
                   showon="guest:1"
                   label="Guest telephone number" 
                   description="Should guests be asked for a telephone number: optional, mandatory or not asked for at all. Telephone numbers are only seen by the booking contact(s) and walk leader." 
                   hint="Should input of telephone number be required for guest users"
            >
                <option value="0">Optional</option>
                <option value="1">Mandatory</option>
                <option value="2">Not requested (field not shown)</option>
            </field>
            <field name="maxguestattendees" 
                   first="1" last="10" step="1" 
                   type="integer" 
                   useglobal="true" 
                   showon="guest:1"
                   label="COM_RA_EVENTBOOKING_FORM_LBL_MAXGUESTATTENDEES" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_MAXGUESTATTENDEES" 
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_MAXGUESTATTENDEES"
            />
            <field name="userlistvisibletoguests" 
                   type="list" 
                   useglobal="true" 
                   validate="options"
                   showon="guest:1"
                   label="COM_RA_EVENTBOOKING_FORM_LBL_USERLISTVISIBLETOGUESTS" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_USERLISTVISIBLETOGUESTS" 
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_USERLISTVISIBLETOGUESTS"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            
            // payments
            
            
            
            <field name="payment_required" 
                   type="useglobalyesno"
                   global_param="payment_required"
                   label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_PAYMENT_REQUIRED" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_PAYMENT_REQUIRED" 
                   hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_PAYMENT_REQUIRED"
            >
                <option value="no">JNO</option>
                <option value="yes">JYES</option>
            </field>
            <field name="payment_details" 
                   showon="payment_required:yes"
                   height="150"
                   filter="safehtml" 
                   type="editor" 
                   useglobal="true"
                   label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_PAYMENT_DETAILS" 
                   description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_PAYMENT_DETAILS" 
                   hint="Description of what payment is required."
            />
            
            
            // comms    

            <field 
                name="booking_contact_id" 
                type="Bookingcontact" 
                useglobal="true" 
                label="Booking Contact" 
                description="Select user who is acting as booking contact for this event" 
            />
       
            <field name="email_booking" 
                   useglobal="true" 
                   type="list" 
                   label="Booking notifications" 
                   description="Send info to booking contact when booking/waiting list changes" 
            >
                <option value="none">No notifications</option>
                <option value="individual">Send copy of booking change emails</option>
                <option value="list">Send booking list email after each change</option>
            </field>
            <field name="notrecommended" 
                   type="note" 
                   label="Not recommended" 
                   showon="email_booking:list"
                   description="This option is not production ready, it currently takes a long time to send the emails" 
                   class="alert alert-info" />
            <field name="email_waiting" 
                   useglobal="true" 
                   showon="email_booking:individual,list"
                   type="list" 
                   label="Which changes" 
                   description="Include waiting list changes as well as booking changes " 
            >
                <option value="0">Booking changes</option>
                <option value="1">Booking and waiting list changes</option>
            </field>
            <field name="copy_group_contact" 
                   type="list" 
                   useglobal="true"
                   default=""
                   showon="email_booking:individual,list"
                   label="Also copy the group contact" 
                   description="Should the group contact (set in the component Options) also be sent a copy of booking, cancellation and waiting list emails, as well as the event contact? The final booking list is always sent to the group contact." 
            >
                <option value="0">Never</option>
                <option value="1">Yes</option>
            </field>
                         
            <field name="notify_event_changed" 
                   type="list" 
                   useglobal="true" 
                   default=""
                   label="Email bookers when walk is amended" 
                   description="Should people who have booked be emailed automatically when the walk is amended in Walks Manager? Contacts can always email bookers themselves from the booking list." 
            >
                <option value="none">Never</option>
                <option value="date">Only if the date or time changes</option>
                <option value="always">Whenever the walk is updated in Walks Manager</option>
            </field>
            <field name="closingoption" 
                   type="list"   
                   useglobal="true"      
                   label="COM_RA_EVENTBOOKING_FORM_LBL_USERLISTCLOSING"
                   description="COM_RA_EVENTBOOKING_FORM_DESC_USERLISTCLOSING">
                <option value="start">When event starts</option>
                <option value="6pm">6pm on the day before event</option>
                <option value="6pmweek">6pm on a week before event</option>
                <option value="7am">7am on the day</option>
                <option value="7amweek">7am a week before</option>
                <option value="custom">Custom</option>
            </field>
            <field name="customclosingdate" 
                   showon="closingoption:custom"
                   type="calendar" 
                   showtime="true"
                   default="NOW" 
                   label="Set Closing date" 
                   description="This is when the bookings for events will end" 
                   format="%Y-%m-%d %H:%M:%S" 
            />
       
            <field name="send_booking_list_onclosed" 
                   type="list" 
                   useglobal="true"
                   default=""
                   validate="options"
                   label="Send booking list when closed" 
                   description="An email, containing the booking list, will be automatically sent to the Booking Contacts once the booking has closed." 
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field name="task_comment" 
                   type="note" 
                   label="Scheduled task not enabled" 
                   showon="send_booking_list_onclosed:1"
                   description="Final booking lists will NOT be sent until the Event Booking email task is enabled in System - Scheduled Tasks, see Users Guide for details" 
                   class="alert alert-danger" />
            <field 
                name="walk_leader_id" 
                type="Walkleader" 
                required="false" 
                showon="send_booking_list_onclosed:1"
                label="Walk/Event Leader - final booking list"
                description="OPTIONAL The Walk/Event Leader will be sent the final booking list once bookings have closed." 
                hint="Select user"
            />
            <field name="final_list_sent" type="hidden" filter="string" default="" /> 
            <field name="bookingemailtextrequired" 
                   type="useglobalyesno"
                   global_param="bookingemailtextrequired"
                   label="Include Booking email text" 
                   description="Do wish to add custom text to emails sent when places are booked" 
            >
                <option value="no">JNO</option>
                <option value="yes">JYES</option>
            </field>
            <field name="bookingemailtext" 
                   showon="bookingemailtextrequired:yes"
                   useglobal="true"
                   filter="safehtml" 
                   height="150"
                   type="editor" 
                   label="Booking emails text" 
                   description="Optional text to add to Booking emails" 
            >
                <editor-options>
                    <option name="startup_mode">design</option>  <!-- Forces visual mode -->
                </editor-options>
            </field>
       
     
           
        </fieldset>
    </fields>
   
    <fieldset name="standard" label="Standard"> 
        <field name="creation_date" type="timecreated" label="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_CREATION_DATE" description="COM_RA_EVENTBOOKING_FORM_DESC_EVENTSETTING_CREATION_DATE" hint="COM_RA_EVENTBOOKING_FORM_LBL_EVENTSETTING_CREATION_DATE"/>
        <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
    </fieldset>
</form>
